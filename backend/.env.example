APP_NAME=CR Integration Portal
APP_VERSION=1.1.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://cr_portal:cr_portal@localhost:5432/cr_portal
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Technical / secret Bitrix parameters only.
# Funnel IDs, user fields and KPI parameters are edited in Admin -> Settings.
BITRIX_BASE_URL=https://bx.crg.im
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
BITRIX_REDIRECT_URI=http://localhost:8000/api/v1/auth/bitrix/callback
BITRIX_WEBHOOK_URL=
